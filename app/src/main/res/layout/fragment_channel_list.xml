<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"> <!-- Background hitam agar efek neon lebih menyala -->

    <!-- NEON VISUALIZER DI BAGIAN ATAS -->
    <se.lublin.mumla.ofa.NeonVisualizerView
        android:id="@+id/neon_visualizer_fragment"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#050505" 
        android:elevation="4dp" />

    <!-- DAFTAR CHANNEL / USER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channelUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true"
        android:clipToPadding="false"
        android:paddingTop="2dp" />

</LinearLayout>