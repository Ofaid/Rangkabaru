<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- SLOT UNTUK AUDIO LEVEL BAR (Baru Ditambahkan) -->
    <se.lublin.mumla.widget.AudioLevelView
        android:id="@+id/audio_level_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="#332B2B2B" />

    <!-- VIEWPAGER UTAMA (Channel List & Chat) -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/channel_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager.widget.PagerTabStrip
            android:id="@+id/channel_tab_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </androidx.viewpager.widget.ViewPager>

    <!-- PANEL TARGET WHISPER (Muncul kalau lagi bisik-bisik) -->
    <LinearLayout
        android:id="@+id/target_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFBB33"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/target_panel_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/target_panel_cancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cancel Target" />
            
    </LinearLayout>

    <!-- TOMBOL PTT (Push-to-Talk) -->
    <FrameLayout
        android:id="@+id/pushtotalk_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <Button
            android:id="@+id/pushtotalk"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PUSH TO TALK"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- INDIKATOR KUNCI MIC (Gembok) -->
        <ImageView
            android:id="@+id/pushtotalk_lock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:visibility="gone"
            android:contentDescription="Lock Indicator" />
            
    </FrameLayout>

</LinearLayout>